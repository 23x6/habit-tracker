# Supabase project (Settings → API). Copy to .env.local and fill in. Never commit real values.
# Only the public URL and the publishable/anon key belong here. NEVER put the service_role key in the client.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# Push reminders (optional). Public VAPID key: used by the app and the server.
VITE_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY

# Server only (Vercel Functions in api/; set in Vercel → Settings → Environment Variables, never with VITE_):
# VAPID_PRIVATE_KEY=...      private VAPID key (npx web-push generate-vapid-keys)
# VAPID_SUBJECT=https://your-app.example/   contact URL or mailto: for push services
# CRON_SECRET=...            random secret, same value as in supabase/setup/reminders-cron.sql
